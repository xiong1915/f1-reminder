name: F1 Race 30-Min Reminder

on:
__SCHEDULE__
  workflow_dispatch:
    inputs:
      test_mode:
        description: '发送一条模拟测试卡片到机器人 (用于验证通路)'
        required: false
        type: boolean
        default: false

# 串行排队执行，杜绝手动触发与定时触发并发冲突导致重复推送
concurrency:
  group: f1-reminder-execution
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  check-and-remind:
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: main

      - name: Run F1 Reminder Check
        env:
          WEEKLY_PLAN: 'true'
          SCHEDULE_CRON: ${{ github.event.schedule || '' }}
          PUSH_KEY: ${{ secrets.PUSH_KEY }}
          PUSHPLUS_CHANNEL: ${{ secrets.PUSHPLUS_CHANNEL || 'wechat' }}
          TEST_MODE: ${{ github.event.inputs.test_mode || 'false' }}
        run: |
          node reminder.js

      - name: Save sent history to repository
        # 即使前序推送报错，也要保存已成功推送的记录与本地拉取的赛程缓存，避免丢失与重复
        if: always()
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"

          # 1. 分别检查实际存在的文件再执行暂存，避免缺失文件导致失败或吞错
          if [ -f history.json ]; then
            git add history.json
          fi


          # 2. 若有文件变更则提交，并在重试耗尽或 rebase 冲突时明确失败报错
          if ! git diff --staged --quiet; then
            git commit -m "chore: persist sent reminder history and schedule cache [skip ci]"
            PUSH_SUCCESS=false
            for i in 1 2 3; do
              echo "Attempting git push (try $i/3)..."
              if git push; then
                PUSH_SUCCESS=true
                break
              fi
              echo "Git push attempt $i failed."
              if [ "$i" -lt 3 ]; then
                echo "Pulling remote changes with rebase..."
                if ! git pull --rebase origin main; then
                  echo "Error: git pull --rebase failed or encountered conflicts. Aborting."
                  exit 1
                fi
                sleep 2
              fi
            done

            if [ "$PUSH_SUCCESS" != "true" ]; then
              echo "Error: Failed to push commit after 3 attempts."
              exit 1
            fi
          fi
